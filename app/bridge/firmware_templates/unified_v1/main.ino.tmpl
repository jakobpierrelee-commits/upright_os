  Serial.print(" outer_loop_enabled=");
  Serial.print(g_outer_loop_enabled ? "1" : "0");
  Serial.print(" target_angle_from_velocity=");
  Serial.print(g_target_angle_from_velocity, 4);
  Serial.print(" motor_l_trim=");
  Serial.print(g_motor_l_trim, 4);
  Serial.print(" motor_r_trim=");
  Serial.print(g_motor_r_trim, 4);
  Serial.print(" drift_diag_state=");
  Serial.print(g_drift_diag_state);
  Serial.print(" wpos=0 wspd=0 encL=0 encR=0 volRaw=0");
  Serial.println();
}

static bool parsePID(const String& s) {
  float kp, ki, kd;
  if (sscanf(s.c_str(), "PID %f %f %f", &kp, &ki, &kd) == 3) {
    g_kp = kp; g_ki = ki; g_kd = kd;
    Serial.println("OK PID");
    return true;
  }
  return false;
}

static bool parseMotion(const String& s) {
  float kv, kx;
  if (sscanf(s.c_str(), "MOTION %f %f", &kv, &kx) == 2) {
    g_kv = kv; g_kx = kx;
    Serial.println("OK MOTION");
    return true;
  }
  return false;
}

static bool parseSetpoint(const String& s) {
  float deg;
  if (sscanf(s.c_str(), "SETPOINT %f", &deg) == 1) {
    g_set = deg;
    Serial.println("OK SETPOINT");
    return true;
  }
  return false;
}

static void handleCommand(const String& cmdRaw) {
  String cmd = cmdRaw;
  cmd.trim();
  if (cmd.length() == 0) return;

  if (cmd == "GET") {
    emitStatus();
    return;
  }
  if (cmd == "HELP") {
    Serial.println("OK HELP GET ARM DISARM CAL ZERO SAVECFG PID MOTION SETPOINT LIMITS BURSTCSV LOGCSV LOGT IDENT");
    return;
  }
  if (cmd == "IDENT") {
    Serial.println("UPRIGHT_UNIFIED_V1");
    return;
  }
  if (cmd == "ARM") {
    g_armed = true;
    Serial.println("OK ARM");
    return;
  }
  if (cmd == "DISARM") {
    g_armed = false;
    g_out = 0.0f;
    applyControlStub(0.0f);
    Serial.println("OK DISARM");
    return;
  }
  if (cmd == "CAL ZERO") {
    // TODO: write your IMU zero routine.
    Serial.println("OK CAL ZERO");
    return;
  }
  if (cmd == "SAVECFG") {
    // TODO: persist config in EEPROM/flash.
    Serial.println("OK SAVECFG");
    return;
  }
  if (parsePID(cmd) || parseMotion(cmd) || parseSetpoint(cmd)) {
    return;
  }
  if (cmd.startsWith("LIMITS ")) {
    Serial.println("OK LIMITS");
    return;
  }
  if (cmd.startsWith("BURSTCSV ")) {
    Serial.println("OK BURSTCSV");
    return;
  }
  if (cmd == "LOGCSV" || cmd == "LOGT") {
    Serial.println("OK LOG");
    return;
  }

  Serial.print("ERR UNKNOWN ");
  Serial.println(cmd);
}

void setup() {
  Serial.begin(115200);
  delay(120);
  Serial.println("UPRIGHT_UNIFIED_BOOT");

  pinMode(PIN_LED, OUTPUT);
  digitalWrite(PIN_LED, LOW);
}

void loop() {
  while (Serial.available() > 0) {
    String cmd = Serial.readStringUntil('\n');
    handleCommand(cmd);
  }

  updateTelemetryStub();

  if (g_armed && !g_estop) {
    // TODO: replace with full controller using real telemetry.
    g_out = (g_set - g_ang) * g_kp;
    applyControlStub(g_out);
  }

  const uint32_t now = millis();
  if (now - g_last_status_ms >= 90) {
    g_last_status_ms = now;
    emitStatus();
    digitalWrite(PIN_LED, !digitalRead(PIN_LED));
  }
}
