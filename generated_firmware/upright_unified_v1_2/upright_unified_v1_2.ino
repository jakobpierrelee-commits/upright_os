static bool parsePID(const String& s) {
  float kp, ki, kd;
  if (sscanf(s.c_str(), "PID %f %f %f", &kp, &ki, &kd) == 3) {
    g_kp = kp;
    g_ki = ki;
    g_kd = kd;
    Serial.println("OK PID");
    return true;
  }
  return false;
}

static bool parseMotion(const String& s) {
  float kv, kx;
  if (sscanf(s.c_str(), "MOTION %f %f", &kv, &kx) == 2) {
    g_kv = kv;
    g_kx = kx;
    Serial.println("OK MOTION");
    return true;
  }
  return false;
}

static bool parseSetpoint(const String& s) {
  float deg;
  if (sscanf(s.c_str(), "SETPOINT %f", &deg) == 1) {
    g_set = deg;
    Serial.println("OK SETPOINT");
    return true;
  }
  return false;
}

static bool parseLimits(const String& s) {
  float out_max, tip_deg, i_max;
  if (sscanf(s.c_str(), "LIMITS %f %f %f", &out_max, &tip_deg, &i_max) == 3) {
    g_out_max = clampf(out_max, 20.0f, 255.0f);
    g_tip_deg = clampf(tip_deg, 5.0f, 60.0f);
    g_i_max = clampf(i_max, 1.0f, 500.0f);
    Serial.println("OK LIMITS");
    return true;
  }
  return false;
}

static bool parseFilter(const String& s) {
  float cutoff_hz;
  int conditional_i;
  if (sscanf(s.c_str(), "FILTER %f %d", &cutoff_hz, &conditional_i) == 2) {
    g_lpf_cutoff_hz = clampf(cutoff_hz, 0.1f, 80.0f);
    g_conditional_i = conditional_i != 0;
    Serial.println("OK FILTER");
    return true;
  }
  return false;
}

static void handleCommand(const String& cmdRaw) {
  String cmd = cmdRaw;
  cmd.trim();
  if (cmd.length() == 0) return;

  if (cmd == "GET") {
    emitStatus();
    return;
  }
  if (cmd == "HELP") {
    Serial.println("OK HELP GET ARM DISARM CAL ZERO SAVECFG PID MOTION SETPOINT LIMITS FILTER BURSTCSV LOGCSV LOGT IDENT");
    return;
  }
  if (cmd == "IDENT") {
    Serial.println("UPRIGHT_UNIFIED_V1");
    return;
  }
  if (cmd == "ARM") {
    g_armed = true;
    g_integral_accum = 0.0f;
    g_prev_err = 0.0f;
    Serial.println("OK ARM");
    return;
  }
  if (cmd == "DISARM") {
    g_armed = false;
    g_out = 0.0f;
    applyControlStub(0.0f);
    Serial.println("OK DISARM");
    return;
  }
  if (cmd == "CAL ZERO") {
    // TODO: write your IMU zero routine.
    g_accel_level_offset = -g_raw;
    g_upright_trim = 0.0f;
    Serial.println("OK CAL ZERO");
    return;
  }
  if (cmd == "SAVECFG") {
    // TODO: persist config in EEPROM/flash.
    Serial.println("OK SAVECFG");
    return;
  }
  if (parsePID(cmd) || parseMotion(cmd) || parseSetpoint(cmd) || parseLimits(cmd) || parseFilter(cmd)) {
    return;
  }
  if (cmd.startsWith("BURSTCSV ")) {
    Serial.println("OK BURSTCSV");
    return;
  }
  if (cmd == "LOGCSV" || cmd == "LOGT") {
    Serial.println("OK LOG");
    return;
  }

  Serial.print("ERR UNKNOWN ");
  Serial.println(cmd);
}

void setup() {
  Serial.begin(115200);
  delay(120);
  Serial.println("UPRIGHT_UNIFIED_BOOT");

  pinMode(PIN_LED, OUTPUT);
  digitalWrite(PIN_LED, LOW);
  g_last_loop_us = micros();
}

void loop() {
  while (Serial.available() > 0) {
    String cmd = Serial.readStringUntil('\n');
    handleCommand(cmd);
  }

  uint32_t now_us = micros();
  float dt_s = (now_us - g_last_loop_us) / 1000000.0f;
  g_last_loop_us = now_us;
  if (dt_s <= 0.0f || dt_s > 0.2f) dt_s = 0.01f;

  updateTelemetryStub(dt_s);

  if (g_armed && !g_estop) {
    if (fabs(g_ang) > g_tip_deg) {
      g_estop = true;
      g_armed = false;
      g_out = 0.0f;
      applyControlStub(0.0f);
    } else {
      g_pid_err = g_set - g_ang;
      g_pid_p = g_kp * g_pid_err;
      g_pid_d = g_kd * ((g_pid_err - g_prev_err) / dt_s);

      const bool integrate_now = (!g_conditional_i) || (!g_output_saturated) || (g_pid_err * g_pid_u_sat < 0.0f);
      if (integrate_now) {
        g_integral_accum += g_pid_err * dt_s;
        g_integral_accum = clampf(g_integral_accum, -g_i_max, g_i_max);
      }
      g_pid_i = g_ki * g_integral_accum;

      // Optional motion feed-forward hooks.
      const float motion_term = (g_kv * g_vel_target) + (g_kx * g_target_angle_from_velocity);

      g_pid_u_unsat = g_pid_p + g_pid_i + g_pid_d + motion_term;
      g_pid_u_sat = clampf(g_pid_u_unsat, -g_out_max, g_out_max);
      g_output_saturated = fabs(g_pid_u_unsat - g_pid_u_sat) > 0.001f;

      g_out = g_pid_u_sat;
      applyControlStub(g_out);
      g_prev_err = g_pid_err;
    }
  } else {
    g_out = 0.0f;
    g_pid_err = 0.0f;
    g_pid_p = 0.0f;
    g_pid_i = 0.0f;
    g_pid_d = 0.0f;
    g_pid_u_unsat = 0.0f;
    g_pid_u_sat = 0.0f;
    g_output_saturated = false;
  }

  const uint32_t now = millis();
  if (now - g_last_status_ms >= 90) {
    g_last_status_ms = now;
    emitStatus();
    digitalWrite(PIN_LED, !digitalRead(PIN_LED));
  }
}
