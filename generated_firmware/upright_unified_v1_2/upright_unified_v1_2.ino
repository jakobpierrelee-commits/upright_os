static float clampf(float v, float lo, float hi) {
  if (v < lo) return lo;
  if (v > hi) return hi;
  return v;
}

static float alphaFromCutoffHz(float cutoff_hz, float dt_s) {
  if (cutoff_hz <= 0.0f || dt_s <= 0.0f) return 1.0f;
  const float tau = 1.0f / (2.0f * PI * cutoff_hz);
  return dt_s / (tau + dt_s);
}

static float lpfGyro(float gyro_meas, float dt_s) {
  if (!g_gyro_lpf_init) {
    g_gyro_lpf = gyro_meas;
    g_gyro_lpf_init = true;
    return g_gyro_lpf;
  }
  const float a = alphaFromCutoffHz(g_lpf_cutoff_hz, dt_s);
  g_gyro_lpf += a * (gyro_meas - g_gyro_lpf);
  return g_gyro_lpf;
}

static void kalmanUpdate(float accel_angle_deg, float gyro_rate_dps, float dt_s) {
  if (dt_s <= 0.0f) dt_s = 0.01f;

  // Predict
  const float rate = gyro_rate_dps - g_kf_bias;
  g_kf_angle += dt_s * rate;

  g_kf_P00 += dt_s * (dt_s * g_kf_P11 - g_kf_P01 - g_kf_P10 + g_kf_q_angle);
  g_kf_P01 -= dt_s * g_kf_P11;
  g_kf_P10 -= dt_s * g_kf_P11;
  g_kf_P11 += g_kf_q_bias * dt_s;

  // Correct
  g_kal_innov = accel_angle_deg - g_kf_angle;
  const float S = g_kf_P00 + g_kf_r_measure;
  if (S <= 1e-9f) return;

  const float K0 = g_kf_P00 / S;
  const float K1 = g_kf_P10 / S;

  g_kf_angle += K0 * g_kal_innov;
  g_kf_bias += K1 * g_kal_innov;

  const float P00_tmp = g_kf_P00;
  const float P01_tmp = g_kf_P01;
  g_kf_P00 -= K0 * P00_tmp;
  g_kf_P01 -= K0 * P01_tmp;
  g_kf_P10 -= K1 * P00_tmp;
  g_kf_P11 -= K1 * P01_tmp;
}

